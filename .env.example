AUTOMATION_ENVIRONMENT=development
AUTOMATION_DATABASE_URL=postgresql+psycopg://automation:automation@postgres:5432/automation
AUTOMATION_REDIS_URL=redis://redis:6379/0
AUTOMATION_AUTH_ENABLED=false
AUTOMATION_OIDC_ISSUER=http://keycloak:8080/realms/automation
AUTOMATION_OIDC_AUDIENCE=automation-api
AUTOMATION_WEBHOOK_SIGNING_SECRET=replace-with-a-managed-secret
AUTOMATION_MAX_WEBHOOK_BODY_BYTES=65536
AUTOMATION_LOG_LEVEL=INFO
AUTOMATION_WORKER_POLL_SECONDS=1
AUTOMATION_WORKER_LEASE_SECONDS=60
AUTOMATION_SCHEDULER_POLL_SECONDS=5
